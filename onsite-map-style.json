{
  "version": 8,
  "name": "OnSite Entrance",
  "metadata": {
    "onsite:purpose": "Construction site entrance placement",
    "onsite:data": "OpenFreeMap / OpenMapTiles / OpenStreetMap"
  },
  "sources": {
    "openmaptiles": {
      "type": "vector",
      "url": "https://tiles.openfreemap.org/planet"
    }
  },
  "glyphs": "https://tiles.openfreemap.org/fonts/{fontstack}/{range}.pbf",
  "layers": [
    {
      "id": "background",
      "type": "background",
      "paint": {
        "background-color": "#f5f5f2"
      }
    },
    {
      "id": "residential-landuse",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "landuse",
      "filter": ["==", ["get", "class"], "residential"],
      "paint": {
        "fill-color": "#f0f1ee",
        "fill-opacity": ["interpolate", ["linear"], ["zoom"], 9, 0.62, 15, 0.86]
      }
    },
    {
      "id": "industrial-landuse",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "landuse",
      "filter": ["match", ["get", "class"], ["industrial", "commercial"], true, false],
      "paint": {
        "fill-color": "#e9ebe8",
        "fill-opacity": 0.88
      }
    },
    {
      "id": "parks",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "park",
      "paint": {
        "fill-color": "#dcebd7",
        "fill-opacity": 0.9,
        "fill-outline-color": "#c9dfc4"
      }
    },
    {
      "id": "woodland",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "landcover",
      "filter": ["==", ["get", "class"], "wood"],
      "paint": {
        "fill-color": "#d4e7d1",
        "fill-opacity": 0.82
      }
    },
    {
      "id": "grassland",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "landcover",
      "filter": ["match", ["get", "class"], ["grass", "farmland"], true, false],
      "paint": {
        "fill-color": "#e2eddc",
        "fill-opacity": 0.78
      }
    },
    {
      "id": "institutional-landuse",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "landuse",
      "filter": ["match", ["get", "class"], ["hospital", "school"], true, false],
      "paint": {
        "fill-color": ["match", ["get", "class"], "hospital", "#f1e1df", "#ebe8d8"],
        "fill-opacity": 0.68
      }
    },
    {
      "id": "water",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "water",
      "filter": ["!=", ["get", "brunnel"], "tunnel"],
      "paint": {
        "fill-color": "#bfe3ef"
      }
    },
    {
      "id": "waterways",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "waterway",
      "filter": ["!=", ["get", "brunnel"], "tunnel"],
      "layout": {
        "line-cap": "round",
        "line-join": "round"
      },
      "paint": {
        "line-color": "#9dcfe1",
        "line-width": ["interpolate", ["linear"], ["zoom"], 9, 0.5, 16, 2.2]
      }
    },
    {
      "id": "aeroway-area",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "aeroway",
      "filter": ["==", ["geometry-type"], "Polygon"],
      "paint": {
        "fill-color": "#e7e9e7",
        "fill-opacity": 0.8
      }
    },
    {
      "id": "road-path",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "minzoom": 14,
      "filter": ["match", ["get", "class"], ["path", "pedestrian"], true, false],
      "layout": {
        "line-cap": "round",
        "line-join": "round"
      },
      "paint": {
        "line-color": "#c8cbc8",
        "line-width": ["interpolate", ["linear"], ["zoom"], 14, 0.7, 19, 4],
        "line-dasharray": [1.5, 1.5]
      }
    },
    {
      "id": "road-local-casing",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "minzoom": 12.5,
      "filter": ["match", ["get", "class"], ["minor", "service", "track"], true, false],
      "layout": {
        "line-cap": "round",
        "line-join": "round"
      },
      "paint": {
        "line-color": "#d1d4d1",
        "line-width": ["interpolate", ["exponential", 1.3], ["zoom"], 13, 1.1, 15, 3.8, 20, 17]
      }
    },
    {
      "id": "road-local",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "minzoom": 12.5,
      "filter": ["match", ["get", "class"], ["minor", "service", "track"], true, false],
      "layout": {
        "line-cap": "round",
        "line-join": "round"
      },
      "paint": {
        "line-color": "#ffffff",
        "line-width": ["interpolate", ["exponential", 1.3], ["zoom"], 13, 0.6, 15, 2.6, 20, 15]
      }
    },
    {
      "id": "road-secondary-casing",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "minzoom": 8,
      "filter": ["match", ["get", "class"], ["secondary", "tertiary"], true, false],
      "layout": {
        "line-cap": "round",
        "line-join": "round"
      },
      "paint": {
        "line-color": "#c4c9c6",
        "line-width": ["interpolate", ["exponential", 1.25], ["zoom"], 8, 0.9, 13, 2.8, 20, 19]
      }
    },
    {
      "id": "road-secondary",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "minzoom": 8,
      "filter": ["match", ["get", "class"], ["secondary", "tertiary"], true, false],
      "layout": {
        "line-cap": "round",
        "line-join": "round"
      },
      "paint": {
        "line-color": "#ffffff",
        "line-width": ["interpolate", ["exponential", 1.25], ["zoom"], 8, 0.5, 13, 1.8, 20, 17]
      }
    },
    {
      "id": "road-primary-casing",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "minzoom": 6,
      "filter": ["match", ["get", "class"], ["primary", "trunk"], true, false],
      "layout": {
        "line-cap": "round",
        "line-join": "round"
      },
      "paint": {
        "line-color": "#bec4c1",
        "line-width": ["interpolate", ["exponential", 1.2], ["zoom"], 6, 0.9, 12, 3.4, 20, 21]
      }
    },
    {
      "id": "road-primary",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "minzoom": 6,
      "filter": ["match", ["get", "class"], ["primary", "trunk"], true, false],
      "layout": {
        "line-cap": "round",
        "line-join": "round"
      },
      "paint": {
        "line-color": "#f8f9f8",
        "line-width": ["interpolate", ["exponential", 1.2], ["zoom"], 6, 0.5, 12, 2.2, 20, 19]
      }
    },
    {
      "id": "road-motorway-casing",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "minzoom": 5,
      "filter": ["==", ["get", "class"], "motorway"],
      "layout": {
        "line-cap": "round",
        "line-join": "round"
      },
      "paint": {
        "line-color": "#bcc2bf",
        "line-width": ["interpolate", ["exponential", 1.2], ["zoom"], 5, 1, 12, 3.5, 20, 22]
      }
    },
    {
      "id": "road-motorway",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "minzoom": 5,
      "filter": ["==", ["get", "class"], "motorway"],
      "layout": {
        "line-cap": "round",
        "line-join": "round"
      },
      "paint": {
        "line-color": "#f1f4f2",
        "line-width": ["interpolate", ["exponential", 1.2], ["zoom"], 5, 0.6, 12, 2.4, 20, 20]
      }
    },
    {
      "id": "rail",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "minzoom": 9,
      "filter": ["==", ["get", "class"], "rail"],
      "paint": {
        "line-color": "#aeb4b6",
        "line-width": ["interpolate", ["linear"], ["zoom"], 9, 0.35, 17, 1]
      }
    },
    {
      "id": "rail-hatching",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "minzoom": 13,
      "filter": ["==", ["get", "class"], "rail"],
      "paint": {
        "line-color": "#f5f6f4",
        "line-width": ["interpolate", ["linear"], ["zoom"], 13, 0.2, 18, 0.8],
        "line-dasharray": [2, 2]
      }
    },
    {
      "id": "buildings",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "building",
      "minzoom": 13,
      "paint": {
        "fill-color": "#d9dbd8",
        "fill-opacity": ["interpolate", ["linear"], ["zoom"], 13, 0.78, 15, 0.98],
        "fill-outline-color": "#b8beb9"
      }
    },
    {
      "id": "water-labels",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "water_name",
      "minzoom": 9,
      "layout": {
        "symbol-placement": "line",
        "text-field": ["coalesce", ["get", "name:latin"], ["get", "name_en"], ["get", "name"]],
        "text-font": ["Noto Sans Regular"],
        "text-size": 11,
        "text-max-angle": 30
      },
      "paint": {
        "text-color": "#4e7c96",
        "text-halo-color": "rgba(245, 246, 244, 0.9)",
        "text-halo-width": 1
      }
    },
    {
      "id": "road-label-major",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "transportation_name",
      "minzoom": 12,
      "filter": ["match", ["get", "class"], ["motorway", "trunk", "primary", "secondary", "tertiary"], true, false],
      "layout": {
        "symbol-placement": "line",
        "text-field": ["coalesce", ["get", "name:latin"], ["get", "name_en"], ["get", "name"]],
        "text-font": ["Noto Sans Regular"],
        "text-size": ["interpolate", ["linear"], ["zoom"], 12, 10, 16, 12],
        "text-max-angle": 30,
        "text-padding": 4
      },
      "paint": {
        "text-color": "#3f454b",
        "text-halo-color": "rgba(255, 255, 255, 0.92)",
        "text-halo-width": 1.2,
        "text-halo-blur": 0.3
      }
    },
    {
      "id": "road-label-local",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "transportation_name",
      "minzoom": 15,
      "filter": ["match", ["get", "class"], ["minor", "service", "track"], true, false],
      "layout": {
        "symbol-placement": "line",
        "text-field": ["coalesce", ["get", "name:latin"], ["get", "name_en"], ["get", "name"]],
        "text-font": ["Noto Sans Regular"],
        "text-size": ["interpolate", ["linear"], ["zoom"], 15, 10, 18, 12],
        "text-max-angle": 25,
        "text-padding": 6
      },
      "paint": {
        "text-color": "#59636d",
        "text-halo-color": "rgba(255, 255, 255, 0.92)",
        "text-halo-width": 1.1,
        "text-halo-blur": 0.25
      }
    },
    {
      "id": "transport-landmarks",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "poi",
      "minzoom": 13,
      "filter": ["match", ["get", "class"], ["airport", "rail", "bus"], true, false],
      "layout": {
        "text-field": ["coalesce", ["get", "name:latin"], ["get", "name_en"], ["get", "name"]],
        "text-font": ["Noto Sans Regular"],
        "text-size": 11,
        "text-max-width": 10,
        "text-padding": 8
      },
      "paint": {
        "text-color": "#4f6673",
        "text-halo-color": "rgba(245, 246, 244, 0.94)",
        "text-halo-width": 1.2
      }
    },
    {
      "id": "public-landmarks",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "poi",
      "minzoom": 15,
      "filter": ["match", ["get", "class"], ["hospital", "college", "school"], true, false],
      "layout": {
        "text-field": ["coalesce", ["get", "name:latin"], ["get", "name_en"], ["get", "name"]],
        "text-font": ["Noto Sans Regular"],
        "text-size": 10,
        "text-max-width": 9,
        "text-padding": 10
      },
      "paint": {
        "text-color": "#707274",
        "text-halo-color": "rgba(245, 246, 244, 0.94)",
        "text-halo-width": 1
      }
    },
    {
      "id": "place-villages",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "place",
      "minzoom": 9,
      "filter": ["match", ["get", "class"], ["village", "suburb", "neighbourhood"], true, false],
      "layout": {
        "text-field": ["coalesce", ["get", "name:latin"], ["get", "name_en"], ["get", "name"]],
        "text-font": ["Noto Sans Regular"],
        "text-size": ["interpolate", ["linear"], ["zoom"], 9, 10, 14, 12],
        "text-max-width": 9,
        "text-padding": 10
      },
      "paint": {
        "text-color": "#696b6e",
        "text-halo-color": "rgba(245, 246, 244, 0.95)",
        "text-halo-width": 1.1
      }
    },
    {
      "id": "place-towns",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "place",
      "minzoom": 6,
      "filter": ["match", ["get", "class"], ["town", "city"], true, false],
      "layout": {
        "text-field": ["coalesce", ["get", "name:latin"], ["get", "name_en"], ["get", "name"]],
        "text-font": ["Noto Sans Regular"],
        "text-size": ["interpolate", ["linear"], ["zoom"], 6, 11, 12, 15],
        "text-max-width": 9,
        "text-padding": 14
      },
      "paint": {
        "text-color": "#44474b",
        "text-halo-color": "rgba(245, 246, 244, 0.96)",
        "text-halo-width": 1.3,
        "text-halo-blur": 0.3
      }
    }
  ]
}
